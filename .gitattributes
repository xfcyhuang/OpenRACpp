# 统一换行策略:文本一律 LF 入库,检出保持 LF(工具链 clang/ninja 无平台差异)
* text=auto eol=lf

# 源码与配置(显式声明)
*.c   text
*.h   text
*.md  text
*.txt text
*.yaml text
*.yml text
*.cmake text
CMakeLists.txt text

# 二进制资产(禁止任何转换)
*.bin  binary
*.png  binary
*.shp  binary
*.mix  binary
*.aud  binary
*.vqa  binary
*.oramap binary
