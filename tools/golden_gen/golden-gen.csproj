<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>golden-gen</AssemblyName>
    <RootNamespace>GoldenGen</RootNamespace>
  </PropertyGroup>

  <PropertyGroup>
    <OpenRaRoot Condition="'$(OpenRaRoot)' == '' AND Exists('..\..\..\openra')">..\..\..\openra</OpenRaRoot>
    <OpenRaRoot Condition="'$(OpenRaRoot)' == '' AND Exists('..\..\..\..\openra')">..\..\..\..\openra</OpenRaRoot>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(OpenRaRoot)\OpenRA.Game\OpenRA.Game.csproj" />
  </ItemGroup>

</Project>
